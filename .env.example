# --- PostgreSQL (host 5434 avoids common local conflicts) ---
POSTGRES_USER=visionops
POSTGRES_PASSWORD=visionops_secret
POSTGRES_DB=visionops_db
POSTGRES_PORT=5434
DATABASE_URL=postgresql://visionops:visionops_secret@localhost:5434/visionops_db

# --- Redis ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# --- MinIO ---
MINIO_ROOT_USER=visionops_minio
MINIO_ROOT_PASSWORD=visionops_minio_secret
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002
MINIO_ENDPOINT=localhost:9001
MINIO_BUCKET=visionops-media
MINIO_SECURE=false

# --- MediaMTX ---
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_RTMP_PORT=1935

# --- Backend API ---
# Prefer 8001 on Windows if :8000 is already taken
API_HOST=127.0.0.1
API_PORT=8001
UI_PORT=3000
# Shared service key for engine/worker → FastAPI (/api/v1). Leave empty to disable API-key auth.
VISIONOPS_API_KEY=visionops-dev-key
# Human dashboard sessions (JWT). Required for multi-user login in the UI.
VISIONOPS_JWT_SECRET=visionops-dev-jwt-secret-change-me
VISIONOPS_JWT_EXPIRE_MINUTES=480
VISIONOPS_ADMIN_USERNAME=admin
VISIONOPS_ADMIN_PASSWORD=visionops-admin
VISIONOPS_ADMIN_FULL_NAME=VisionOps Admin
CAMERA_NAME=demo-camera

# Browser-facing MinIO host (presigned URLs). Inside Compose, API talks to minio:9000.
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9001

# Values baked into the UI image at build time (browser → host ports)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8001/api/v1/ws/detections
NEXT_PUBLIC_HLS_URL=http://127.0.0.1:8888/cam1/index.m3u8
NEXT_PUBLIC_WHEP_URL=/api/mediamtx/whep?path=cam1

# --- Vision Engine ---
# Leave empty to auto-download a demo MP4
VIDEO_SOURCE=
# Optional: path for annotated output video
VIDEO_OUTPUT=visionops-engine/data/annotated_output.mp4
YOLO_MODEL=yolov8n.pt
ONNX_MODEL=visionops-engine/yolov8n_416.onnx
YOLO_IMGSZ=416
YOLO_CONF=0.25
MAX_FRAMES=0
USE_ONNX=true
